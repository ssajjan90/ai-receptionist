# Copy this file to .env and fill in your values (never commit .env)

# Database
DB_URL=jdbc:postgresql://localhost:5432/aireceptionist
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (RSA key pair — generate with: openssl genrsa | openssl pkcs8 -topk8 -nocrypt)
APP_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n<your-rsa-private-key>\n-----END PRIVATE KEY-----
APP_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<your-rsa-public-key>\n-----END PUBLIC KEY-----

# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=<your-meta-webhook-verify-token>
WHATSAPP_APP_SECRET=<your-meta-app-secret>
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_ACCESS_TOKEN=<your-whatsapp-cloud-api-access-token>

# OCR
GOOGLE_APPLICATION_CREDENTIALS=/path/to/google-service-account.json
OCR_PROVIDER=google

# Spring AI / LLM
SPRING_AI_OPENAI_API_KEY=<your-openai-api-key>
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=gpt-4o

# Grafana Cloud OTLP (prod only)
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
GRAFANA_OTLP_TOKEN=<your-grafana-cloud-token>
